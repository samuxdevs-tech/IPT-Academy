{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipt-course-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ipt-course-db",
      "database_id": "7eee0f3e-d5d0-4e0b-9a07-9b83562851b5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ipt-course-tasks"
    }
  ]
}
