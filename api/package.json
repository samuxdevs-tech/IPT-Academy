{
  "name": "ipt-course-api",
  "version": "1.0.0",
  "type": "module",
  "description": "IPT Course Cloudflare Worker Backend (D1 + R2 + Workers AI)",
  "main": "src/index.ts",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js",
    "dev": "wrangler dev",
    "test": "tsx --test src/tests/*.test.ts",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ipt-course-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "esbuild": "^0.17.19",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
